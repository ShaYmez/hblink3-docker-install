# Flush routine for HBlink3 (ShaYmez docker only)

echo "Stopping services....."
sleep 1

echo "Stopping HBlink3 + HBMonv2 (If not already stopped)...."
cd /etc/hblink3
docker compose down --remove-orphans
echo "Done."
sleep 1

echo "HBlink3 Flush and maintenance loop starting....."
sleep 1

echo "Starting truncate main log folder /var/log....."
truncate -s 0 /var/log/*log 2>/dev/null || true

echo "Starting truncate HBlink3 entire log /var/log/hblink....."
truncate -s 0 /var/log/hblink/*log 2>/dev/null || true

echo "Starting truncate HBMonv2 logs /var/log/hbmon....."
truncate -s 0 /var/log/hbmon/*log 2>/dev/null || true

#Restart all services gracefully
echo "Restart all services....."
sleep 1

echo "Restarting docker app....."
systemctl restart docker
echo "Done."
sleep 1

echo "Restart apache2....."
systemctl restart apache2
echo "Done."
sleep 1

echo "Starting HBlink3 + HBMonv2....."
sleep 1
echo .
sleep 1
echo ..
sleep 1
echo ...
cd /etc/hblink3
docker compose up -d

sleep 1
figlet "HBlink 3"
sleep 1

echo "Checking HBlink is composed....."
sleep 1
docker ps

sleep 3
echo "Checking startup error logs....."
docker container logs hblink 2>/dev/null | tail -30
echo "Done."

echo "Flushing network tracking table....."
conntrack -F
sleep 1

echo "Dashboard (HBMonv2 Docker)....."
figlet "HBMonv2"
docker container logs hbmon 2>/dev/null | tail -20
echo "Done."
sleep 1

echo "Done. Now Exiting....."
sleep 1
echo .
sleep 1
echo ..
sleep 1
echo ...
echo "HBlink 3 stack is now online. Flush is complete. AKA ShaYmez."
#
# This script has been developed by the one and only ShaYmez. Visit https://repo.radio/ShaYmez for more super scripts!
echo "All systems have been flushed/cleaned and ready to go. Aka Dr. Node. ShaYmez, HBlink3"
