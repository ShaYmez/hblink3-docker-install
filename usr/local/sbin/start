# Start routine for HBlink3 (ShaYmez docker only)

clear

echo "Starting HBlink3 + HBMonv2....."
cd /etc/hblink3
sleep 1
echo .
sleep 1
echo ..
sleep 1
echo ...
docker compose up -d

sleep 1
figlet "HBlink 3"
sleep 1

echo "Checking HBlink is composed....."
sleep 1
docker ps

sleep 3
echo "Checking startup error logs....."
docker container logs hblink 2>/dev/null | tail -30
echo "Done."

echo "Flushing network tracking table....."
conntrack -F
sleep 1

echo "HBMonv2 dashboard (Docker)....."
figlet "HBMonv2"
docker container logs hbmon 2>/dev/null | tail -20
echo "Done."
sleep 1

echo "Done. Now Exiting....."
sleep 1
echo .
sleep 1
echo ..
sleep 1
echo ...
echo "HBlink3 stack is now online (HBlink3 + HBMonv2 via Docker). AKA ShaYmez."
#
# This script has been developed by the one and only ShaYmez. Visit https://repo.radio/ShaYmez for more super scripts!
