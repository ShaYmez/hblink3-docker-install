services_menu() {
while : ; do
opt=$(whiptail --title "HBlink3 — Services" --menu "Start, stop, and flush the Docker stack." 16 58 6 \
1 " Start HBlink " \
2 " Stop HBlink " \
3 " Restart HBlink " \
4 " Flush HBlink / Truncate Logs " \
b " Back " 3>&1 1>&2 2>&3) || return
case $opt in
1) sudo /usr/local/sbin/hblink-start ;;
2) sudo /usr/local/sbin/hblink-stop ;;
3) sudo /usr/local/sbin/hblink-restart ;;
4) sudo /usr/local/sbin/hblink-flush ;;
b) return ;;
esac
done
}

config_menu() {
while : ; do
opt=$(whiptail --title "HBlink3 — Configuration" --menu "Edit server and dashboard config files." 16 58 6 \
1 " Edit HBlink Config " \
2 " Edit HBlink Rules " \
3 " Edit Dashboard Config " \
4 " Edit Dashboard PHP Config " \
b " Back " 3>&1 1>&2 2>&3) || return
case $opt in
1) sudo nano /etc/hblink3/hblink.cfg ;;
2) sudo nano /etc/hblink3/rules.py ;;
3) sudo nano /etc/hblink3/config.py ;;
4) sudo nano /var/www/html/include/config.php ;;
b) return ;;
esac
done
}

dashboard_menu() {
while : ; do
opt=$(whiptail --title "HBlink3 — Dashboard" --menu "Talkgroup Manager login and HTML refresh." 16 64 6 \
1 " Talkgroup Manager User " \
2 " Upgrade Dashboard HTML " \
3 " Sync Dashboard (incl. menu / branding) " \
b " Back " 3>&1 1>&2 2>&3) || return
case $opt in
1) sudo /usr/local/sbin/hblink-tgmanager-user ;;
2) sudo /usr/local/sbin/hblink-dashboard-upgrade ;;
3)
        if whiptail --title "Sync Dashboard" --yesno "Replace buttons.html and include/config.php from HBMonv2 as well as pages/CSS.\n\nLogos under img/ are kept. A backup is written first.\n\nContinue?" 14 64; then
                sudo /usr/local/sbin/hblink-dashboard-upgrade --all
        fi
        ;;
b) return ;;
esac
done
}

updates_menu() {
while : ; do
opt=$(whiptail --title "HBlink3 — Updates" --menu "Docker images, HBMon migrate, and apt." 16 58 6 \
1 " Update HBlink / Docker " \
2 " Upgrade HBMon to Docker " \
3 " System Update / apt update " \
b " Back " 3>&1 1>&2 2>&3) || return
case $opt in
1) sudo /usr/local/sbin/hblink-update ;;
2) sudo /usr/local/sbin/hblink-upgrade ;;
3) sudo apt-get update -y && sudo apt-get upgrade ;;
b) return ;;
esac
done
}

system_menu() {
while : ; do
opt=$(whiptail --title "HBlink3 — System" --menu "Uninstall or power off the host." 15 58 5 \
1 " Uninstall HBlink3 " \
2 " Reboot Entire Server " \
3 " Shutdown Entire Server " \
b " Back " 3>&1 1>&2 2>&3) || return
case $opt in
1) sudo /usr/local/sbin/hblink-uninstall ;;
2) sudo reboot ;;
3) sudo shutdown now ;;
b) return ;;
esac
done
}

while : ; do
menuopt=$(whiptail --title "HBlink3 Control Version 2.0" --menu "Select a section. Cancel or Esc exits." 18 58 8 \
1 " Services " \
2 " Configuration " \
3 " Dashboard " \
4 " Updates " \
5 " System " 3>&1 1>&2 2>&3)
exitstatus=$?
if [ $exitstatus = 0 ]; then
        echo "You have chosen option:" $menuopt
else
        echo "Type 'hblink-menu' to enter HBlink3 Control Menu "
        break
fi
case $menuopt in
1) services_menu ;;
2) config_menu ;;
3) dashboard_menu ;;
4) updates_menu ;;
5) system_menu ;;
esac
done
exit 0

# Whiptail menu system by ShaYmez https://github.com/ShaYmez
